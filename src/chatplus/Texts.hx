package chatplus;

using StringTools;

/// The mod's texts in English and German. The language follows the game (`Options.language`); every
/// other language gets English. `{0}`, `{1}`, ... are replaced by the arguments.
class Texts {
    /// `de` for German, anything else for English.
    public static var lang = "en";

    public static function get(key:String, ?args:Array<Dynamic>):String {
        var text = (lang == "de" ? DE.get(key) : null);
        if (text == null) {
            text = EN.get(key);
        }

        if (text == null) {
            return key;
        }

        if (args != null) {
            for (i in 0...args.length) {
                text = text.replace("{" + i + "}", Std.string(args[i]));
            }
        }

        return text;
    }

